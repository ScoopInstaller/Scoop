#!/bin/sh
# Rebuilds the prebuilt assemblies under supporting/ when their source is in the
# commit, and stages the result. Mirrors the "Prebuilt binaries" CI job.
# Enabled by `git config core.hooksPath .githooks` (test/bin/init.ps1 does it on the
# first run); skip one commit with `git commit --no-verify`.
set -e

root=$(git rev-parse --show-toplevel)
changed=$(git diff --cached --name-only | grep -E '^supporting/[^/]+/(.*\.cs|build\.ps1)$' || true)
[ -z "$changed" ] && exit 0

if ! command -v pwsh >/dev/null 2>&1; then
    echo "pre-commit: pwsh not found, skipping the supporting/ rebuild" >&2
    exit 0
fi

projects=$(printf '%s\n' "$changed" | sed -E 's#^supporting/([^/]+)/.*#\1#' | sort -u)
for project in $projects; do
    script="$root/supporting/$project/build.ps1"
    [ -f "$script" ] || continue
    # Without the packages the build would need the network; leave that to CI.
    if [ ! -d "$root/supporting/$project/packages" ]; then
        echo "pre-commit: supporting/$project has no packages/ yet, run its build.ps1 once first" >&2
        exit 0
    fi
    echo "pre-commit: rebuilding supporting/$project"
    pwsh -NoProfile -File "$script" -Fast
    git add "$root/supporting/$project/bin"
done
